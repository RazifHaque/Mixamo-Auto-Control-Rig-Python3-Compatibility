diff --git a/MayaAutoControlRig/Utils/General.py b/MayaAutoControlRig/Utils/General.py
index 084c8f0..fbbe9d6 100644
--- a/MayaAutoControlRig/Utils/General.py
+++ b/MayaAutoControlRig/Utils/General.py
@@ -12 +12,2 @@ import re
-import cPickle
+import pickle as cPickle
+import base64
@@ -229 +230,3 @@ def pyToAttr(objAttr, data):
-    stringData = cPickle.dumps(data)
+    # Python 3 pickle returns bytes; encode as ASCII-safe text for Maya string attributes.
+    pickleData = cPickle.dumps(data, protocol=cPickle.HIGHEST_PROTOCOL)
+    stringData = base64.b64encode(pickleData).decode('ascii')
@@ -235,3 +238,14 @@ def attrToPy(objAttr):
-        stringAttrData = str(mayac.getAttr(objAttr))
-        loadedData = cPickle.loads(stringAttrData)
-        return loadedData
+        stringAttrData = mayac.getAttr(objAttr)
+        if stringAttrData is None:
+            return None
+        # New Python 3/base64 format.
+        try:
+            pickleData = base64.b64decode(stringAttrData.encode('ascii'), validate=True)
+            return cPickle.loads(pickleData)
+        except Exception:
+            pass
+        # Best-effort compatibility with old Python 2 string pickles.
+        try:
+            return cPickle.loads(str(stringAttrData).encode('latin1'), encoding='latin1')
+        except Exception:
+            return None
